// LeetCode 416
// Partition Equal Subset Sum (Memoization)
// Topic: Dynamic Programming
// Difficulty: Medium
// Time Complexity: O(n * target)
// Space Complexity: O(n * target)

class Solution {
    Boolean[][]dp;

    public boolean canPartition(int[]nums){
        int sum=0;

        for(int x:nums){
            sum+=x;
        }

        if(sum%2!=0){
            return false;
        }

        dp=new Boolean[nums.length][sum/2+1];

        return solve(nums,0,sum/2);
    }

    boolean solve(int[]nums,int i,int target){

        if(target==0){
            return true;
        }

        if(i==nums.length){
            return false;
        }

        if(dp[i][target]!=null){
            return dp[i][target];
        }

        boolean take=false;

        if(nums[i]<=target){
            take=solve(nums,i+1,target-nums[i]);
        }

        boolean notTake=solve(nums,i+1,target);

        return dp[i][target]=take || notTake;
    }
}
