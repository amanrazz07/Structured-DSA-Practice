// LeetCode 1137
// N-th Tribonacci Number (Memoization)
// Topic: Dynamic Programming
// Difficulty: Easy
// Time Complexity: O(n)
// Space Complexity: O(n)

import java.util.*;

class Solution {
    public int tribonacci(int n){
        int[]dp=new int[n+1];
        Arrays.fill(dp,-1);

        return solve(n,dp);
    }

    public static int solve(int i,int[]dp){
        if(i==0)return 0;
        if(i<=2)return 1;

        if(dp[i]==-1){
            dp[i]=solve(i-1,dp)+
                  solve(i-2,dp)+
                  solve(i-3,dp);
        }

        return dp[i];
    }
}
