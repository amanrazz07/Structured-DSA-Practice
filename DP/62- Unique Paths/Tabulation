// LeetCode 62
// Unique Paths (Tabulation)
// Topic: Dynamic Programming
// Difficulty: Medium
// Time Complexity: O(m*n)
// Space Complexity: O(m*n)

import java.util.*;

class Solution {
    public int uniquePaths(int m,int n){
        int[][]dp=new int[m][n];

        // first row
        Arrays.fill(dp[0],1);

        // first column
        for(int i=0;i<m;i++){
            dp[i][0]=1;
        }

        // fill remaining cells
        for(int i=1;i<m;i++){
            for(int j=1;j<n;j++){
                dp[i][j]=dp[i-1][j]+dp[i][j-1];
            }
        }

        return dp[m-1][n-1];
    }
}
