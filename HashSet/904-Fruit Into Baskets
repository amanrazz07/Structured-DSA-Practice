// LeetCode 904
// Fruit Into Baskets
// Topic: Sliding Window, HashMap
// Difficulty: Medium
// Time Complexity: O(n)
// Space Complexity: O(1) // at most 3 keys in map

import java.util.*;

class Solution {
    public int totalFruit(int[]fruits){
        int l=0;
        int ans=0;

        HashMap<Integer,Integer>map=new HashMap<>();

        for(int r=0;r<fruits.length;r++){

            map.put(
                fruits[r],
                map.getOrDefault(fruits[r],0)+1
            );

            while(map.size()>2){

                map.put(
                    fruits[l],
                    map.get(fruits[l])-1
                );

                if(map.get(fruits[l])==0){
                    map.remove(fruits[l]);
                }

                l++;
            }

            ans=Math.max(ans,r-l+1);
        }

        return ans;
    }
}
