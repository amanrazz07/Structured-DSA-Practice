// LeetCode 3274
// Count 3-Digit Even Numbers
// Topic: Arrays, HashSet, Brute Force
// Difficulty: Easy
// Time Complexity: O(n^3)
// Space Complexity: O(n)

import java.util.*;

class Solution {
    public int totalNumbers(int[]digits){
        HashSet<Integer>set=new HashSet<>();
        int n=digits.length;

        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                for(int k=0;k<n;k++){
                    if(i==j||j==k||k==i){
                        continue;
                    }

                    if(digits[i]==0){
                        continue;
                    }

                    if(digits[k]%2!=0){
                        continue;
                    }

                    int num=digits[i]*100+digits[j]*10+digits[k];
                    set.add(num);
                }
            }
        }

        return set.size();
    }
}
