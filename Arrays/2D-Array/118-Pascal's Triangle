// LeetCode 118
// Pascal's Triangle
// Topic: Arrays, Dynamic Programming
// Difficulty: Easy
// Time Complexity: O(n^2)
// Space Complexity: O(n^2)

import java.util.*;

class Solution {
    public List<List<Integer>> generate(int numRows){
        List<List<Integer>>ans=new ArrayList<>();
        int n=numRows;

        // initialize all rows with 1
        for(int i=0;i<n;i++){
            List<Integer>list=new ArrayList<>();

            for(int j=0;j<=i;j++){
                list.add(1);
            }

            ans.add(list);
        }

        // fill inner values
        for(int i=2;i<n;i++){
            for(int j=1;j<i;j++){
                ans.get(i).set(
                    j,
                    ans.get(i-1).get(j-1)+ans.get(i-1).get(j)
                );
            }
        }

        return ans;
    }
}
