// LeetCode 2144
// Minimum Cost of Buying Candies With Discount
// Topic: Arrays, Greedy, Sorting
// Difficulty: Easy
// Time Complexity: O(n log n)
// Space Complexity: O(1) // ignoring sorting space

import java.util.*;

class Solution {
    public int minimumCost(int[]cost){
        Arrays.sort(cost);

        int ans=0;
        int count=0;

        for(int i=cost.length-1;i>=0;i--){
            count++;

            // every 3rd candy is free
            if(count==3){
                count=0;
                continue;
            }

            ans+=cost[i];
        }

        return ans;
    }
}
