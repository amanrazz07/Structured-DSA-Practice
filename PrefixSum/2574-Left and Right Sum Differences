// LeetCode 2574
// Left and Right Sum Differences
// Topic: Arrays, Prefix Sum
// Difficulty: Easy
// Time Complexity: O(n)
// Space Complexity: O(1) // excluding output array

class Solution {
    public int[] leftRightDifference(int[]nums){
        int n=nums.length;

        int total=0;
        for(int x:nums){
            total+=x;
        }

        int left=0;
        int[]ans=new int[n];

        for(int i=0;i<n;i++){
            int right=total-left-nums[i];

            ans[i]=Math.abs(left-right);

            left+=nums[i];
        }

        return ans;
    }
}
