// Smallest Index With Digit Sum Equal to Index
// Topic: Arrays, Math
// Difficulty: Easy
// Time Complexity: O(n*d)
// Space Complexity: O(1)

class Solution {
    public int smallestIndex(int[]nums){
        for(int i=0;i<nums.length;i++){
            int sum=0;
            int x=nums[i];

            while(x>0){
                int r=x%10;
                sum+=r;
                x/=10;
            }

            if(sum==i){
                return i;
            }
        }

        return -1;
    }
}
