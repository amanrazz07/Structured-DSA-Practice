// Assign Cookies
// Topic: Greedy, Two Pointers, Sorting
// Difficulty: Easy
// Time Complexity: O(n log n + m log m)
// Space Complexity: O(1) // ignoring sorting space

import java.util.*;

class Solution {
    public int findContentChildren(int[]g,int[]s){
        Arrays.sort(g);
        Arrays.sort(s);

        int count=0;
        int i=0,j=0;

        while(i<g.length && j<s.length){

            if(g[i]<=s[j]){
                count++;
                i++;
                j++;
            }else{
                j++;
            }
        }

        return count;
    }
}
